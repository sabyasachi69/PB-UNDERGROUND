# Public Supabase project values. These are safe for the browser when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only values. Never expose these with a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=
# Phase 4 accepts test-mode keys only (rzp_test_...). Set all three together.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Canonical public origin, for example http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
